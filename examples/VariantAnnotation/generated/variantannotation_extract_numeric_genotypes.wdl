version 1.0

# Generated by BiocJobs 0.99.0 from the 'variantannotation-extract-numeric-genotypes' job declared in
# Bioconductor package VariantAnnotation (inst/biocjobs/). Do not edit;
# regenerate with: Rscript -e 'BiocJobs::biocjobsCLI()' wdl <pkg> variantannotation-extract-numeric-genotypes

task variantannotation_extract_numeric_genotypes {
    input {
        File vcf
        File index
        File bed
        File samples
    }

    command <<<
        set -euo pipefail
        Rscript -e 'BiocJobs::execJob("VariantAnnotation", "variantannotation-extract-numeric-genotypes")' \
            --vcf '~{sub(vcf, "'", "'\\''")}' \
            --index '~{sub(index, "'", "'\\''")}' \
            --bed '~{sub(bed, "'", "'\\''")}' \
            --samples '~{sub(samples, "'", "'\\''")}' \
            --numeric_genotypes 'numeric_genotypes.tsv.gz'
    >>>

    output {
        File numeric_genotypes = "numeric_genotypes.tsv.gz"
    }

    runtime {
        docker: "bioconductor/bioconductor_docker:RELEASE_3_23"
        cpu: 1
        memory: "16 GB"
        disks: "local-disk 10 HDD"
    }

    parameter_meta {
        vcf: "VCF (variant call format) file. Bgzipped VCF in standard format, listing variant information and genotypes.. Format: vcf.bgz."
        index: "TBI tabix index for VCF. Index such as that generated by 'bcftools index --tbi'. Necessary for extraction of specific regions from the VCF.. Format: tbi."
        bed: "BED file of regions to include. BED files are tab-delimited. The first column contains the chromosome name, the second column the 0-indexed position indicating the start of the region, and the third column the 1-indexed position indicating the end of the region. Additional columns are optional. The script will only process variants in regions defined by the BED file.. Format: bed."
        samples: "File listing samples to include. Plain text file listing one sample per line. Sample names must match the column headers in the VCF. Samples not listed in this file will not be included in the output.. Format: txt."
    }

    meta {
        description: "Imports a BED file indicating regions to output, as well as a plain text file listing samples to include. Then uses VariantAnnotation to import the GT matrix from the indexed VCF. Only variants that pass filtering are retained. Outputs a tab-delimited text containing chromsome, position, reference and alternative alleles, and genotypes expressed as alternative allele count."
        biocjobs_package: "VariantAnnotation"
        biocjobs_job: "variantannotation-extract-numeric-genotypes"
        biocjobs_job_version: "1.0.0"
    }
}
